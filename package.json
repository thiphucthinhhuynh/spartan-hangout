{
  "name": "spartan-hangout",
  "private": true,
  "description": "Spartan Hangout — find and organize small group activities at SJSU (CMPE 131, Group 5)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "codegen": "npm run build -w @sh/shared && npm run db:generate -w @sh/api",
    "predev": "npm run codegen",
    "dev": "concurrently -n shared,api,web -c magenta,blue,green \"npm:dev -w @sh/shared\" \"npm:dev -w @sh/api\" \"npm:dev -w @sh/web\"",
    "prebuild": "npm run codegen",
    "build": "npm run build -w @sh/api && npm run build -w @sh/web",
    "pretypecheck": "npm run codegen",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run codegen",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @sh/api",
    "db:migrate": "npm run db:migrate -w @sh/api",
    "db:reset": "npm run db:reset -w @sh/api",
    "db:seed": "npm run db:seed -w @sh/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
