# Copy to apps/api/.env for local development. Values match docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://spartan:spartan@localhost:5432/spartan_hangout
# Used by `npm test` (integration tests). Never point this at the development database.
DATABASE_URL_TEST=postgresql://spartan:spartan@localhost:5432/spartan_hangout_test
