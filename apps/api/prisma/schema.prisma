// Spartan Hangout database schema.
// Tables are added milestone by milestone; see docs/data-model.md for the full plan.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Activity type list (open question Q4, decided 2026-10-27: the five types in the UI mockups).
enum ActivityType {
  STUDY
  SPORTS
  FOOD
  SOCIAL
  GAMING
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum ActivityStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum NotificationType {
  ACTIVITY_CHANGED
  ACTIVITY_CANCELLED
  ACTIVITY_UPDATE
  REMOVED_FROM_ACTIVITY
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  DIRECT_MESSAGE
}

// ─── M1: accounts (FR01–FR04) ───────────────────────────────────────────────
// CHECK constraints live in the migration SQL (Prisma cannot express them):
//   user: email is lowercase and ends in @sjsu.edu; at least one interest
//   availability_slot: day 0–6, minutes 0–1439, end after start

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Stored lowercased. Never exposed to other students (FR04, FR13).
  email              String         @unique
  passwordHash       String         @map("password_hash")
  displayName        String         @map("display_name") @db.VarChar(50)
  interests          ActivityType[]
  role               Role           @default(STUDENT)
  status             UserStatus     @default(PENDING_VERIFICATION)
  /// Login lockout state (FR11), used from M2.
  failedLoginCount   Int            @default(0) @map("failed_login_count") @db.SmallInt
  firstFailedLoginAt DateTime?      @map("first_failed_login_at") @db.Timestamptz(3)
  lockedUntil        DateTime?      @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// "Last-updated" time for profile edits (FR06).
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  availability        AvailabilitySlot[]
  verificationTokens  EmailVerificationToken[]
  sessions            Session[]
  blocksMade          Block[]                  @relation("blocker")
  blocksReceived      Block[]                  @relation("blocked")
  connectionsAsA      Connection[]             @relation("connectionA")
  connectionsAsB      Connection[]             @relation("connectionB")
  organizedActivities Activity[]               @relation("organizer")
  participations      Participation[]
  activityRemovals    ActivityRemoval[]
  notifications       Notification[]           @relation("recipient")
  notificationsCaused Notification[]           @relation("actor")

  @@map("user")
}

/// Weekly availability as campus-local wall-clock time (ADR-0011).
model AvailabilitySlot {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek   Int    @map("day_of_week") @db.SmallInt
  /// Minutes after local midnight
  startMinute Int    @map("start_minute") @db.SmallInt
  endMinute   Int    @map("end_minute") @db.SmallInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("availability_slot")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the token in the emailed link; the raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_token")
}

// ─── M2: sessions (FR09–FR11) ───────────────────────────────────────────────

/// Server-side login session (ADR-0009). The cookie holds the raw token; only its hash is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Sliding 30-minute idle timeout (FR10); refreshed at most once a minute.
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ─── M3: relationships (read by common/relationships.ts) ────────────────────
// Created now so every feature can check blocks and connections from the start.
// Rows are added by blocking (M12) and connection requests (M9).
// CHECK constraints in the migration SQL: no self-blocks; each connection pair stored once (a < b).

/// FR54–FR57: `blocker` has blocked `blocked`.
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}

/// FR46: two connected students, stored once with userAId < userBId.
model Connection {
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userA User @relation("connectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("connectionB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
  @@map("connection")
}

// ─── M4: activities, participation, notifications ───────────────────────────
// CHECK constraints in the migration SQL: participant limit 2–100, count between 0 and the limit,
// end after start.

/// FR26–FR32. Times are UTC instants; the form's date and times are campus-local (ADR-0011).
model Activity {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Null only after the organizer deletes their account (shown as "Deleted Student").
  organizerId        String?        @map("organizer_id") @db.Uuid
  title              String         @db.VarChar(100)
  description        String         @db.VarChar(500)
  type               ActivityType
  startAt            DateTime       @map("start_at") @db.Timestamptz(3)
  endAt              DateTime       @map("end_at") @db.Timestamptz(3)
  location           String         @db.VarChar(100)
  /// Includes the organizer (FR26).
  participantLimit   Int            @map("participant_limit") @db.SmallInt
  /// Denormalized for the atomic join (ADR-0010); always equals the participation row count.
  participantCount   Int            @default(1) @map("participant_count") @db.SmallInt
  status             ActivityStatus @default(OPEN)
  cancellationReason String?        @map("cancellation_reason") @db.VarChar(200)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// "Last-updated" time for edits (FR30).
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer      User?             @relation("organizer", fields: [organizerId], references: [id], onDelete: SetNull)
  participations Participation[]
  removals       ActivityRemoval[]
  notifications  Notification[]

  @@index([status, startAt])
  @@index([organizerId, startAt])
  @@map("activity")
}

/// A student in an activity. The organizer has a row too (FR28). The row is also the chat access.
model Participation {
  activityId  String   @map("activity_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  isOrganizer Boolean  @default(false) @map("is_organizer")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
  @@index([userId])
  @@map("participation")
}

// ─── M6: removals ───────────────────────────────────────────────────────────

/// The organizer removed this student (FR33–FR34). While the row exists they can't rejoin (FR21d).
model ActivityRemoval {
  activityId String   @map("activity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Optional reason from the organizer; null for block removals (FR56).
  reason     String?  @db.VarChar(200)
  removedAt  DateTime @default(now()) @map("removed_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
  @@index([userId])
  @@map("activity_removal")
}

/// In-app notification (FR40–FR42). Created inside the transaction of the change that caused it.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  recipientId   String           @map("recipient_id") @db.Uuid
  type          NotificationType
  activityId    String?          @map("activity_id") @db.Uuid
  /// Title at the time of the notification, so it still reads correctly after a rename (FR42).
  activityTitle String?          @map("activity_title") @db.VarChar(100)
  actorId       String?          @map("actor_id") @db.Uuid
  body          String?          @db.VarChar(500)
  readAt        DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User      @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?     @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  activity  Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notification")
}
